{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOCK IN constrained director proposal",
  "description": "A proposal only. Local code validates identity, freshness, provenance, graph, quiet, lure, warning and recovery guards before committing it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "stateVersion", "tactic", "target", "evidenceEventIds", "reasonCode", "tauntId"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stateVersion": { "type": "integer", "minimum": 0 },
    "tactic": { "type": "string", "enum": ["INVESTIGATE_SOUND", "CIRCLE_SHELTER", "LISTEN_NEAR", "FOLLOW_LURE", "WAIT", "TAUNT", "RETREAT"] },
    "target": { "type": "string", "enum": ["SHELTER", "EMITTER_A", "EMITTER_B", "CONTAINMENT", "NONE"] },
    "evidenceEventIds": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "reasonCode": { "type": "string", "enum": ["RECENT_SOUND", "PATTERN_OF_MISTAKES", "QUIET_AFTER_NOISE", "SUSTAINED_NEARBY_TREND", "EARNED_LURE", "RECOVERY", "VARY_PRESSURE", "NO_VALID_SIGNAL"] },
    "tauntId": { "type": "string", "enum": ["NONE", "AFTER_MISTAKE", "MACHINES_QUIET", "HEARD_RHYTHM", "LURE_FOLLOWED"] }
  }
}
