# Copy to .env (never commit it). Read by the Electron main process only.
# Never put a secret in a VITE_* variable — those get bundled into the renderer.
GEMINI_API_KEY=
GEMINI_MODEL=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
PRESAGE_API_KEY=

# Public Convex deployment URL for the renderer. `npx convex dev` writes this
# (and CONVEX_DEPLOYMENT) to .env.local for you.
VITE_CONVEX_URL=
