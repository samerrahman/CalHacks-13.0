# Copy to .env (never commit it). Read by the Electron main process only.
# Never put a secret in a VITE_* variable — those get bundled into the renderer.
# Check your keys with `npm run providers`.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

CARTESIA_API_KEY=
# One stock voice for every radio line, genuine or fake. Pick at play.cartesia.ai/voices.
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6-2026-08-27

PRESAGE_API_KEY=

# VITE_CONVEX_URL and CONVEX_DEPLOYMENT are written to .env.local by `npx convex dev`.
