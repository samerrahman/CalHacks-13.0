GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DIALOGUE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Tutorial/radio voice. Blank uses ElevenLabs' premade British "Daniel" (onwK4e9ZLuTAKqWW03F9); the monster keeps ELEVENLABS_VOICE_ID.
ELEVENLABS_RADIO_VOICE_ID=
ELEVENLABS_MODEL_ID=
PRESAGE_API_KEY=
# Public SpacetimeDB connection settings. Leave DB name blank for local-only traces.
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=scary-5zsk8
# Public origin of a hosted web build (e.g. https://shouldhaveskipped.work) so friends can open spectate links.
VITE_SPECTATE_ORIGIN=https://shouldhaveskipped.work
# Optional public ICE servers for the live spectator camera (JSON array of RTCIceServer). Shipped to
# every browser, so never put a secret here. Blank uses stun:stun.l.google.com:19302.
VITE_RTC_ICE_SERVERS=
